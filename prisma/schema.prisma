generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Council sessions ─────────────────────────────────────────────────────────

model Session {
  id        String   @id @default(cuid())
  mode      String   // 'parallel' | 'cascade' | 'loop'
  title     String?
  savedAt   DateTime @default(now())

  /// Serialised Turn[] or AgentMessage[][] — stored as JSON until we add
  /// relational turn tables.
  turnsJson           Json     @default("[]")
  parallelMessagesJson Json?

  /// Snapshot of agent configs used in this session.
  agentsJson Json @default("[]")

  /// Reference ids attached when the session ran.
  refIds Json @default("[]")

  /// Which agent indices were active (0-2).
  selectedIdxs Json @default("[]")

  memoryEntries MemoryEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([savedAt(sort: Desc)])
}

// ─── Memory ───────────────────────────────────────────────────────────────────

model MemoryEntry {
  id       String         @id @default(cuid())
  category MemoryCategory
  text     String
  addedAt  DateTime       @default(now())

  /// The session this entry was distilled from, if any.
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([addedAt(sort: Desc)])
}

enum MemoryCategory {
  theme
  preference
  good_idea
  dismissed
  question
}

// ─── Memory settings ──────────────────────────────────────────────────────────
// Single-row config. Keyed by a stable singleton id so upsert is trivial.

model MemorySettings {
  id              String   @id @default("singleton")
  enabled         Boolean  @default(false)
  lastDistilledAt DateTime?

  updatedAt DateTime @updatedAt
}

// ─── Engine ───────────────────────────────────────────────────────────────────
// A run is one pass over one digest week by one pair of seats. Runs are
// append-only: re-running a week with a better model writes a new run rather
// than replacing the old one, so a score can be compared against the score it
// superseded.

model EngineRun {
  id      String @id @default(cuid())
  /// Which engine produced it — 'ai' today, other domains later.
  domain  String
  /// The digest week: year file plus its index within that file, oldest-first.
  year    String
  weekIdx Int
  heading String

  analystModel String
  criticModel  String?

  /// The frame's `Last reviewed` date at the time of the run. When §2 changes,
  /// this is the only way to know which runs are still comparable.
  frameReviewedAt String?

  scores EngineScore[]

  startedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([domain, year, weekIdx, startedAt(sort: Desc)])
  @@index([startedAt(sort: Desc)])
}

/// The analyst's row, exactly as it was returned. Never edited — a critic's
/// correction is recorded on the note that proposed it, and the effective score
/// is derived by layering applied notes over this one. Overwriting would
/// destroy the prediction, which is the only thing that can later be graded.
model EngineScore {
  id    String    @id @default(cuid())
  runId String
  run   EngineRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  /// arXiv id, without version suffix.
  paperId String
  title   String

  /// string[] — bullets.
  summary Json
  /// What kind of work it is — prompting, agents, training, and so on.
  category String @default("Unclassified")
  level    String

  /// The two lines that frame the whole reading: what already works, and what
  /// this paper proposes instead.
  previousParadigm String @default("")
  corePremise      String @default("")

  inversion Int
  /// A few words, for the ranked view. The detail sits below it.
  inversionHeadline String @default("")
  /// The BASELINE claim this creation contradicts, selected by id out of the
  /// sealed snapshot, plus that claim in its own words. The words are copied so
  /// a row still reads if the snapshot is ever re-authored under the same id.
  baselineId String?
  paradigm   String @default("")
  /// The rung on the 0-5 inversion ladder. The band it opens is what bounded
  /// the 0-10 score beside it; the whole derivation is in `derivation`.
  inversionLevel Int?
  /// Filing only, copied from the selected claim's tag. Never read by a score.
  paradigmTag String?
  /// The snapshot every id on this row was selected from. A selection means
  /// nothing without it.
  paradigmAsOf String?
  /// Which analyst prompt produced this row. 0 or null is the file constant.
  /// The snapshot answers "measured against what"; this answers "measured how".
  promptVersion Int?
  inverting Json

  /// ─── retired with the layer/bottleneck schema ─────────────────────────────
  /// Kept nullable so rows scored before the redesign still read. Nothing
  /// writes them; the level ladder replaced every ceiling they fed.
  paradigmImportance Int     @default(0)
  paradigmLayer      String?
  paradigmRelation   String?
  paradigmProposes   String?
  magnitude          String?
  /// Paired string[] — the prior approach against the proposed one, read
  /// side by side. Same length wherever the model can manage it.
  previous  Json?
  proposed  Json?

  incentives         Int
  incentivesHeadline String @default("")
  /// The PRESSURE this creation acts on, selected by id out of the snapshot,
  /// and what it does to that pressure. `incentiveAction` carries no ceiling of
  /// its own — it is here so a paper that reveals or measures a constraint is
  /// legible as such rather than reading as relief that failed.
  pressureId      String?
  incentiveAction String?
  incentivesLevel Int?
  /// The shape of the practical gain — efficiency, cost, a new workflow.
  outcomeKind     String @default("")
  /// The size of it, in the paper's own units. "Not quantified" when the paper
  /// claims a gain without measuring one — which is itself worth recording.
  outcomeEstimate String @default("")
  bottleneck      Json

  inflection         Int
  inflectionHeadline String @default("")
  /// The closest EXISTING PRODUCT, selected by id out of the snapshot. Null is
  /// a claim — nothing listed is meaningfully prior art — and the row is
  /// required to have argued it.
  precedentId     String?
  precedentName   String?
  inflectionLevel Int?
  unprecedented   Json

  /// Retired with the two-axis I³. Nullable for rows scored before the redesign.
  precedent String?

  /// How each law's score was reached — the model's claim, the ceilings that
  /// applied, and which one bound. Kept so the reasoning can be inspected and
  /// adjusted rather than inferred from a final number.
  derivation Json?

  /// Derived from the three laws server-side, never taken from the model.
  product    Int
  /// RETIRED. Briefly held a derived "this creation is paradigm-defining"
  /// verdict combining a law at 9+ with a product threshold. The threshold was
  /// a second hand-tuned number nobody had asked for, and it made a row with a
  /// huge I² and an ordinary I¹/I³ read as a paradigm event — the exact case
  /// the three separate laws exist to keep apart. A 9-10 now means
  /// paradigm-defining ON THAT LAW, and the product carries overall magnitude.
  /// Kept nullable so the rows written while it existed still read.
  paradigmDefining Boolean?
  verdict    String
  confidence String

  model            String
  cost             Float   @default(0)
  promptTokens     Int     @default(0)
  completionTokens Int     @default(0)
  truncated        Boolean @default(false)

  /// Every critic pass over this row, oldest first. They stack.
  critiques EngineCritique[]

  scoredAt DateTime @default(now())

  @@index([runId])
  @@index([paperId])
  @@index([product(sort: Desc)])
}

/// One pass of the critic seat. A score may have SEVERAL, and they stack rather
/// than replace: each round reads the row as the rounds before it left it, and
/// its accepted corrections layer on top.
///
/// It used to be one-per-score, and a re-run deleted the previous critique — so
/// the resolutions recorded against its notes went with it and every accepted
/// correction silently reverted to the analyst's original. The reasoning for
/// that was "a decision about a note a different model never made is
/// meaningless", which is true of REPLACING a critique and false of adding one:
/// a second seat is a second reading of the same row, not a redo of the first.
model EngineCritique {
  id      String      @id @default(cuid())
  scoreId String
  score   EngineScore @relation(fields: [scoreId], references: [id], onDelete: Cascade)

  /// 1-based pass number, so a reader can tell round two's objection from
  /// round one's without comparing timestamps.
  round Int @default(1)

  /// Which critic prompt produced this pass. 0 or null is the file constant.
  promptVersion Int?

  model            String
  cost             Float @default(0)
  promptTokens     Int   @default(0)
  completionTokens Int   @default(0)

  notes EngineNote[]

  createdAt DateTime @default(now())

  @@index([scoreId, round])
}

/// One note per section. `resolution` is the analyst's decision on an
/// objection — it does not change the score row, it layers over it.
model EngineNote {
  id         String         @id @default(cuid())
  critiqueId String
  critique   EngineCritique @relation(fields: [critiqueId], references: [id], onDelete: Cascade)

  section String
  agrees  Boolean

  /// string[]
  reasoning       Json
  /// The three steps an objection can land on: which snapshot id should have
  /// been selected, which rung it should have been classified as, and what the
  /// score should read. An objection at step 1 makes the other two moot, and
  /// keeping them apart is what lets a backtest count wrong-object errors
  /// separately from disagreements about a number.
  proposedId      String?
  proposedLevel   Int?
  proposedScore   Int?
  proposedBullets Json?

  /// 'applied' | 'dismissed' — null while the flag is still open.
  resolution String?
  resolvedAt DateTime?

  @@index([critiqueId])
}

/// What the outside world shows about a paper's artefact. Keyed by paper rather
/// than by score, because it is a property of the work and not of any one
/// reading of it, and because it changes on its own clock.
///
/// This is CONFIRMATION evidence and must never reach a score. `Signals and
/// Base Rates` is explicit: attention is not adoption, and star counts preceded
/// the corpus's most expensive false positive.
model EngineExternal {
  id      String @id @default(cuid())
  paperId String @unique

  /// [{ owner, name, url, stars, forks, openIssues, pushedAt, archived, description }]
  repos Json

  /// Set when the paper names no repository at all — itself a finding.
  noRepo Boolean @default(false)

  /// The seat that sorted the paper's own artefact from the repositories it
  /// merely cites. Cheap work, but not mechanical.
  model            String @default("")
  cost             Float  @default(0)
  promptTokens     Int    @default(0)
  completionTokens Int    @default(0)

  checkedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([checkedAt(sort: Desc)])
}

/// A digest row taken out of the reading. Some entries can never be scored —
/// the digest links somewhere other than arXiv, so there is no paper to pull
/// and nothing to run — and left in place they fill the week with rows that
/// exist only to be scrolled past. Setting one aside hides it; nothing is
/// deleted, and it can be restored from the foot of the month.
///
/// Keyed by the row's place in the digest rather than by arXiv id, because the
/// rows most likely to be set aside are precisely the ones that have no id.
model EngineAside {
  id      String @id @default(cuid())
  domain  String
  year    String
  weekIdx Int
  /// The digest's own number for the row within its week.
  n       Int

  /// Kept when there is one, so a set-aside row can still be found by paper.
  paperId String?

  setAt DateTime @default(now())

  @@unique([domain, year, weekIdx, n])
  @@index([domain, year, weekIdx])
}

/// An edited seat prompt. The file constants in lib/engine/prompts.ts remain the
/// BUILT-IN version; a row here overrides one, and the newest version per seat
/// is what the routes send.
///
/// Versions are append-only for the same reason scores are: the ledger holds
/// frozen predictions, and a prediction is only frozen if the instrument that
/// produced it can still be read back. `EngineScore.promptVersion` and
/// `EngineCritique.promptVersion` name the row that was actually used, so two
/// scores taken a day apart can be told apart when the prompt moved between
/// them. Editing in place would make that unanswerable.
model EnginePrompt {
  id   String @id @default(cuid())
  /// 'analyst' | 'critic' | 'external'
  seat String
  /// 1-based, per seat. Version 0 is the file constant and is never stored.
  version Int
  text    String
  /// Why it was changed, for the reader comparing two runs.
  note String?

  createdAt DateTime @default(now())

  @@unique([seat, version])
  @@index([seat, version(sort: Desc)])
}
